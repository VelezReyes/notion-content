{
  "rules": {
    ".read": false,
    ".write": false,
    "session": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "responses": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$questionIndex": {
        "$voterId": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$voterId": {
        ".write": "auth != null && auth.uid === $voterId"
      }
    }
  }
}
